#!/usr/bin/env goo

# Test file for compiler integration

printf("Testing compiler integration")

# This should work fine
x := 42
y := "hello"

# This has a syntax error - missing operator
if x y {
    printf("This line has an error")
}

# Test Goo-specific features
if x and y {
    printf("and operator works")
}

if x ≠ 0 {
    printf("unicode operator works")
}

# Test lambda syntax
numbers := [1, 2, 3]
doubled := numbers.apply(x => x * 2)

printf("Test completed")