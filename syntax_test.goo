#!/usr/bin/env goo

# Test all new Goo syntax features from GOO.md

printf("=== Testing Latest Goo Features ===")

# Test character literals
char1 := 'a'
char2 := '你'
printf("Characters:", char1, char2)

# Test lambda syntax with =>
numbers := [1, 2, 3]
doubled := numbers.apply(x => x * 2)
printf("Doubled:", doubled)

# Test array indexing with #
first := numbers#1  // 1-indexed
printf("First element:", first)

# Test 'in' operator
check 2 in [1, 2, 3]

# Test 'is' operator for type assertion
if x is int {
    printf("x is an integer")
}

# Test enum syntax
enum Status { OK, BAD }

# Test class via type struct
class Person {
    name string
    age int
}

# Test try/catch blocks
try {
    panic("test error")
} catch e {
    printf("Caught:", e)
}

# Test optional chaining
// obj?.field?.method()

# Test string concatenation
result := "hello" + 1  // Should work in Goo
printf("Concat result:", result)

# Test put function
data := {active: true, age: 30, name: "Alice"}
put(data)  // Should print the map

# Test list comparison
check [1, 2] == [1, 2]

# Test string methods (if supported)
str := "hello world"
if str.contains("world") {
    printf("String contains 'world'")
}

printf("=== All features tested ===")