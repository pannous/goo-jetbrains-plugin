#!/usr/bin/env goo

# Test valid Goo syntax

printf("Testing valid Goo features")

x := 42
name := "Goo Developer"

# Test and/or operators
if x > 0 and name ≠ "" {
    printf("✓ Condition works")
}

# Test ø (nil)
ptr := ø
if ptr == ø {
    printf("✓ nil check works")
}

# Test not operator
if not (x < 0) {
    printf("✓ not operator works")
}

# Test check keyword
check x > 0

printf("All tests passed!")