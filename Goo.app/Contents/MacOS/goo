#!/bin/bash

# Goo wrapper for go binary
# This script acts as a Goo compiler by preprocessing Goo syntax and calling go

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"

# Find go binary
GO_BINARY=""
if command -v go &> /dev/null; then
    GO_BINARY="go"
elif [ -f "/usr/local/bin/go" ]; then
    GO_BINARY="/usr/local/bin/go"
elif [ -f "/usr/bin/go" ]; then
    GO_BINARY="/usr/bin/go"
else
    echo "Error: go binary not found. Please install Go first."
    exit 1
fi

# Function to preprocess Goo files
preprocess_goo() {
    local input_file="$1"
    local output_file="$2"
    
    # Convert Goo syntax to Go syntax
    sed -e 's/\bprintf\b/fmt.Println/g' \
        -e 's/\band\b/\&\&/g' \
        -e 's/\bor\b/||/g' \
        -e 's/\bnot\b/!/g' \
        -e 's/¬/!/g' \
        -e 's/≠/!=/g' \
        -e 's/\bø\b/""/g' \
        -e 's/^#/\/\//g' \
        -e 's/[[:space:]]#/ \/\//g' \
        "$input_file" > "$output_file"
}

# If no arguments, show help
if [ $# -eq 0 ]; then
    echo "Goo - Enhanced Go Programming Language"
    echo ""
    echo "Usage:"
    echo "  goo run <file.goo>     Run a Goo program"
    echo "  goo build <file.goo>   Build a Goo program"
    echo "  goo <go-command>       Pass through to go binary"
    echo ""
    echo "Goo extends Go with:"
    echo "  - # comments (in addition to //)"
    echo "  - 'and'/'or' operators instead of &&/||" 
    echo "  - '¬'/'not' operator instead of !"
    echo "  - '≠' operator instead of !="
    echo "  - 'ø' keyword instead of 'nil'"
    echo "  - 'printf' as synonym for 'fmt.Println'"
    exit 0
fi

# Handle Goo-specific commands
case "$1" in
    "run")
        if [ $# -lt 2 ]; then
            echo "Error: goo run requires a file argument"
            exit 1
        fi
        
        GOO_FILE="$2"
        if [ ! -f "$GOO_FILE" ]; then
            echo "Error: file '$GOO_FILE' not found"
            exit 1
        fi
        
        # Create temporary Go file
        TEMP_GO_FILE=$(mktemp /tmp/goo_XXXXXX.go)
        trap "rm -f '$TEMP_GO_FILE'" EXIT
        
        # Preprocess Goo to Go
        preprocess_goo "$GOO_FILE" "$TEMP_GO_FILE"
        
        # Run with go
        shift 2  # Remove 'run' and filename
        "$GO_BINARY" run "$TEMP_GO_FILE" "$@"
        ;;
        
    "build")
        if [ $# -lt 2 ]; then
            echo "Error: goo build requires a file argument"
            exit 1
        fi
        
        GOO_FILE="$2"
        if [ ! -f "$GOO_FILE" ]; then
            echo "Error: file '$GOO_FILE' not found"
            exit 1
        fi
        
        # Create temporary Go file
        TEMP_GO_FILE=$(mktemp /tmp/goo_XXXXXX.go)
        trap "rm -f '$TEMP_GO_FILE'" EXIT
        
        # Preprocess Goo to Go
        preprocess_goo "$GOO_FILE" "$TEMP_GO_FILE"
        
        # Build with go
        shift 2  # Remove 'build' and filename
        OUTPUT_NAME="${GOO_FILE%.*}"  # Remove .goo extension
        "$GO_BINARY" build -o "$OUTPUT_NAME" "$TEMP_GO_FILE" "$@"
        ;;
        
    *)
        # Pass through to go binary for other commands
        exec "$GO_BINARY" "$@"
        ;;
esac