#!/bin/bash

# Goo GUI Application - handles file opening from Finder and open command

# Enable debug logging
DEBUG_LOG="/tmp/goo-app-debug.log"
echo "$(date): Goo.app started with args: $*" >> "$DEBUG_LOG"

# Handle macOS process serial number argument
if [[ "$1" =~ ^-psn_ ]]; then
    echo "$(date): Removing PSN argument: $1" >> "$DEBUG_LOG"
    shift
fi

# Function to open file with appropriate action
handle_goo_file() {
    local file="$1"
    echo "$(date): Handling Goo file: $file" >> "$DEBUG_LOG"
    
    # Show user options via AppleScript dialog
    local choice=$(osascript << EOF
tell application "System Events"
    activate
    set userChoice to button returned of (display dialog "What would you like to do with '$file'?" buttons {"Edit in TextEdit", "Run with Goo", "Build with Goo"} default button "Edit in TextEdit" with title "Goo File Handler")
    return userChoice
end tell
EOF
)
    
    echo "$(date): User chose: $choice" >> "$DEBUG_LOG"
    
    case "$choice" in
        "Edit in TextEdit")
            open -a TextEdit "$file"
            ;;
        "Run with Goo")
            # Open Terminal and run the file with correct working directory
            local dir=$(dirname "$file")
            local filename=$(basename "$file")
            osascript << EOF
tell application "Terminal"
    activate
    do script "cd '$dir' && goo run '$filename'"
end tell
EOF
            ;;
        "Build with Goo")
            # Open Terminal and build the file with correct working directory
            local dir=$(dirname "$file")
            local filename=$(basename "$file")
            osascript << EOF
tell application "Terminal"
    activate
    do script "cd '$dir' && goo build '$filename'"
end tell
EOF
            ;;
    esac
}

# Main logic
if [ $# -eq 0 ]; then
    # No arguments - show general info dialog
    echo "$(date): No arguments, showing info dialog" >> "$DEBUG_LOG"
    osascript << 'EOF'
tell application "System Events"
    activate
    display dialog "Goo Programming Language

Command Line Usage:
• goo run file.goo - Run a Goo program
• goo build file.goo - Build a Goo program

To use with files:
• Drag .goo files to this app
• Use 'open -a Goo file.goo'" buttons {"Open Terminal", "OK"} default button "OK" with title "Goo Compiler"
    if button returned is "Open Terminal" then
        tell application "Terminal"
            activate
            do script "goo"
        end tell
    end if
end tell
EOF
    
elif [ $# -eq 1 ] && [[ "$1" == *.goo ]] && [ -f "$1" ]; then
    # Single .goo file - handle it
    echo "$(date): Single .goo file detected: $1" >> "$DEBUG_LOG"
    handle_goo_file "$1"
    
elif [ $# -gt 1 ]; then
    # Multiple files - handle each .goo file
    echo "$(date): Multiple files detected" >> "$DEBUG_LOG"
    for file in "$@"; do
        if [[ "$file" == *.goo ]] && [ -f "$file" ]; then
            handle_goo_file "$file"
        fi
    done
    
else
    # Unknown arguments - show error
    echo "$(date): Unknown arguments: $*" >> "$DEBUG_LOG"
    osascript << EOF
tell application "System Events"
    activate
    display dialog "Goo can only handle .goo files.

Received: $*" buttons {"OK"} default button "OK" with title "Goo Error"
end tell
EOF
fi

echo "$(date): Goo.app finished" >> "$DEBUG_LOG"